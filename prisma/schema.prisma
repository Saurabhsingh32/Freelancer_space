generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  name                String
  passwordHash        String
  razorpayContactNote String?
  createdAt           DateTime   @default(now())
  clientDeals         Deal[]     @relation("ClientDeals")
  freelancerDeals     Deal[]     @relation("FreelancerDeals")
  evidence            Evidence[]
  events              Event[]    @relation("ActorEvents")
}

model Deal {
  id           String       @id @default(cuid())
  title        String
  status       String       @default("open")
  clientId     String
  freelancerId String?
  createdAt    DateTime     @default(now())
  client       User         @relation("ClientDeals", fields: [clientId], references: [id])
  freelancer   User?        @relation("FreelancerDeals", fields: [freelancerId], references: [id])
  milestones   Milestone[]
  invites      DealInvite[]
  events       Event[]
}

model DealInvite {
  id        String   @id @default(cuid())
  token     String   @unique
  dealId    String
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Milestone {
  id                String     @id @default(cuid())
  dealId            String
  title             String
  description       String     @default("")
  amountPaise       Int
  dueAt             DateTime?
  status            String     @default("draft")
  razorpayOrderId   String?
  razorpayPaymentId String?
  submittedAt       DateTime?
  autoReleaseAt     DateTime?
  releasedAt        DateTime?
  payoutPending     Boolean    @default(false)
  createdAt         DateTime   @default(now())
  deal              Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  evidence          Evidence[]
  events            Event[]
}

model Evidence {
  id          String    @id @default(cuid())
  milestoneId String
  userId      String
  kind        String
  body        String    @default("")
  filePath    String?
  fileName    String?
  createdAt   DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
}

model Event {
  id          String     @id @default(cuid())
  dealId      String
  milestoneId String?
  actorId     String?
  type        String
  payloadJson String     @default("{}")
  createdAt   DateTime   @default(now())
  deal        Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  actor       User?      @relation("ActorEvents", fields: [actorId], references: [id])
}
